    {
      "id": 7,
      "type": "timeseries",
      "title": "Availability burn rate (pages at 14.4x over 1h and 6x over 6h)",
      "description": "1x spends exactly the 30-day budget. Dashed lines are the slow (6x) and fast (14.4x) paging thresholds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate5m{service=\"gateway\", slo=\"availability\"} / on(service, slo) slo:error_budget:ratio",
          "legendFormat": "5m",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate1h{service=\"gateway\", slo=\"availability\"} / on(service, slo) slo:error_budget:ratio",
          "legendFormat": "1h",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate6h{service=\"gateway\", slo=\"availability\"} / on(service, slo) slo:error_budget:ratio",
          "legendFormat": "6h",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "min": 0
        },
        "overrides": []
